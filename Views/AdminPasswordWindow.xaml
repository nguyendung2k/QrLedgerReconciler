<Window x:Class="QrLedgerReconciler.Views.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QrLedgerReconciler.Controls"
        Title="Xác thực quản trị"
        Width="360" MinHeight="230"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid>
                                <Border x:Name="Overlay" CornerRadius="10" Background="Black" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Xác thực quản trị" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Nhập mật khẩu admin để mở màn hình quản lý tài khoản."
                   Margin="0,4,0,14" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <controls:PasswordInput x:Name="PasswordInput"
                                Height="42"
                                KeyDown="PasswordInput_KeyDown"/>

        <TextBlock x:Name="ErrorText" Margin="2,6,0,0" FontSize="11"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

        <TextBlock x:Name="HintText" Margin="2,6,0,0" FontSize="10.5"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="Lần đầu sử dụng: mật khẩu admin mặc định là &quot;admin&quot;. Hãy đổi ngay trong màn hình quản lý."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" Style="{StaticResource DialogButton}"
                    Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    Click="Cancel_Click"/>
            <Button Content="Xác nhận" Style="{StaticResource DialogButton}"
                    Background="{StaticResource AccentBrush}" Margin="0"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>