<Window x:Class="QrLedgerReconciler.Views.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QrLedgerReconciler.Controls"
        Title="Xác thực quản trị"
        Width="360" MinHeight="230"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F4F6"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Xác thực quản trị" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Nhập mật khẩu admin để mở màn hình quản lý tài khoản."
                   Margin="0,4,0,14" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <controls:PasswordInput x:Name="PasswordInput"
                                KeyDown="PasswordInput_KeyDown"/>

        <TextBlock x:Name="ErrorText" Margin="2,6,0,0" FontSize="11"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

        <TextBlock x:Name="HintText" Margin="2,6,0,0" FontSize="10.5"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="Lần đầu sử dụng: mật khẩu admin mặc định là &quot;admin&quot;. Hãy đổi ngay trong màn hình quản lý."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" Style="{StaticResource DialogButton}"
                    Background="#E5E7EB" Foreground="#374151"
                    Click="Cancel_Click"/>
            <Button Content="Xác nhận" Style="{StaticResource DialogButton}"
                    Background="{StaticResource AccentBrush}" Margin="0"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>