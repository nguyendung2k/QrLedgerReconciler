<Window x:Class="QrLedgerReconciler.Views.ChangeAdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QrLedgerReconciler.Controls"
        Title="Đổi mật khẩu admin"
        Height="330" Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Đổi mật khẩu admin" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Dùng mật khẩu này để mở màn hình quản lý tài khoản."
                   Margin="0,4,0,14" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}"/>
        <controls:PasswordInput x:Name="OldPasswordBox"/>

        <TextBlock Text="Mật khẩu mới" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
        <controls:PasswordInput x:Name="NewPasswordBox"/>

        <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
        <controls:PasswordInput x:Name="ConfirmPasswordBox"/>

        <TextBlock x:Name="ErrorText" Margin="2,8,0,0" FontSize="11"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" Style="{StaticResource DialogButton}"
                    Background="#E5E7EB" Foreground="#374151"
                    Click="Cancel_Click"/>
            <Button Content="Xác nhận" Style="{StaticResource DialogButton}"
                    Background="{StaticResource AccentBrush}" Margin="0"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>