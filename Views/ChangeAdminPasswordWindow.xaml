<Window x:Class="QrLedgerReconciler.Views.ChangeAdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QrLedgerReconciler.Controls"
        Title="Đổi mật khẩu admin"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid>
                                <Border x:Name="Overlay" CornerRadius="10" Background="Black" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Đổi mật khẩu admin" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Dùng mật khẩu này để mở màn hình quản lý tài khoản."
                   Margin="0,4,0,14" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}"/>
        <controls:PasswordInput x:Name="OldPasswordBox" Height="42"/>

        <TextBlock Text="Mật khẩu mới" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
        <controls:PasswordInput x:Name="NewPasswordBox" Height="42"/>

        <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
        <controls:PasswordInput x:Name="ConfirmPasswordBox" Height="42"/>

        <TextBlock x:Name="ErrorText" Margin="2,8,0,0" FontSize="11"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" Style="{StaticResource DialogButton}"
                    Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    Click="Cancel_Click"/>
            <Button Content="Xác nhận" Style="{StaticResource DialogButton}"
                    Background="{StaticResource AccentBrush}" Margin="0"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>