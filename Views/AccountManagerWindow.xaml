<Window x:Class="QrLedgerReconciler.Views.AccountManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QrLedgerReconciler.Controls"
        Title="Quản lý tài khoản &amp; phân quyền EGAS"
        Height="700" Width="1050"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#EEF0FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Palette + style dùng chung (Card, FieldLabel, ModernTextBox, nút...) được
             định nghĩa ở App.xaml và thừa hưởng ở đây. Chỉ khai báo style riêng của màn này. -->

        <!-- ===================== SIDEBAR ===================== -->
        <Style x:Key="AccountList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="AccountListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F0FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F0FD"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill trạng thái -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <!-- Nút 3 chấm -->
        <Style x:Key="DotsButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Content" Value="⋯"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E5E7F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TAB ===================== -->
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="10,10,0,0" Padding="18,0"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"
                                              ContentSource="Header" Margin="0,12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AccentToggle / StatusToggle / GlyphIcon thừa hưởng từ App.xaml -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="0"
                Margin="12,12,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header gradient -->
                <Border Grid.Row="0" Background="{StaticResource SidebarHeaderBrush}" Padding="20,22"
                        CornerRadius="11,11,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel>
                            <TextBlock Text="Danh sách tài khoản" FontSize="15" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Quản lý người dùng và phân quyền" FontSize="11.5"
                                       Foreground="#DCD8FB" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nút thêm mới -->
                <Button Grid.Row="1" Content="+  Thêm tài khoản" Style="{StaticResource PrimaryButton}"
                        Margin="16,16,16,8" Height="42" FontSize="14"
                        HorizontalContentAlignment="Center"
                        Command="{Binding AddCommand}"/>

                <!-- Danh sách -->
                <ListBox Grid.Row="2" Style="{StaticResource AccountList}"
                         ItemContainerStyle="{StaticResource AccountListItem}"
                         ItemsSource="{Binding Accounts}"
                         Margin="8,0,8,8"
                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserName}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource StatusPill}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Hoạt động" Style="{StaticResource StatusPillText}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Grid.Column="2" Style="{StaticResource DotsButton}"
                                        VerticalAlignment="Center"
                                        Click="DotsButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource ModernContextMenu}">
                                            <MenuItem Header="Xoá tài khoản"
                                                      Tag="&#xE74D;"
                                                      Style="{StaticResource ModernMenuItem}"
                                                      Click="DeleteAccount_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===================== NỘI DUNG CHÍNH ===================== -->
        <Grid Grid.Row="0" Grid.Column="2" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab header -->
            <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0"
                        ItemContainerStyle="{StaticResource TabItemStyle}"
                        SelectionChanged="TabControl_SelectionChanged">
                <TabItem Header="Thông tin tài khoản"/>
                <TabItem Header="Chạy ẩn"/>
                <TabItem Header="Cài đặt"/>
            </TabControl>

            <!-- Nội dung tab -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,0">
                <Grid>
                    <!-- ============ TAB 1: THÔNG TIN TÀI KHOẢN ============ -->
                    <Grid x:Name="AccountTab">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header: tên + pill trạng thái -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EditUserName}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding EditDisplayName}" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource StatusPill}" Padding="12,6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditIsEnabled}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="6,0,0,0" FontSize="12.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusPillText}">
                                                <Setter Property="Text" Value="Hoạt động"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditIsEnabled}" Value="False">
                                                        <Setter Property="Text" Value="Đã tắt"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Form thông tin -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tên đăng nhập EGAS" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}"/>
                                    <controls:PasswordInput Height="42"
                                                            Password="{Binding EditPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tên hiển thị / Ghi chú" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,11">
                                    <CheckBox Style="{StaticResource AccentToggle}"
                                              IsChecked="{Binding EditIsEnabled, Mode=TwoWay}"/>
                                    <TextBlock Text="Đang hoạt động" FontSize="13.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Khung phân quyền -->
                        <Border Grid.Row="4" Style="{StaticResource InnerPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="Phân quyền chức năng" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="12,5" CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CheckedFunctionCount}" Value="0">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                            <Run Text="Đã chọn:" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Run Text="{Binding CheckedFunctionCount, Mode=OneWay}"
                                                 Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                            <Run Text="/ 7" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FunctionOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource PermissionCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="8"
                                                                Background="{StaticResource AccentSoftBrush}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="3" Style="{StaticResource AccentToggle}"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ TAB 2: CHẠY ẨN ============ -->
                    <Grid x:Name="HeadlessTab" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="1" Style="{StaticResource InnerPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Text="Cấu hình chạy ẩn" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Cấu hình các chức năng được thực hiện mà không mở cửa sổ Chrome."
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="26,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Lưu cấu hình" Style="{StaticResource PrimaryButton}"
                                            Height="36" VerticalAlignment="Top" Command="{Binding SaveHeadlessCommand}"/>
                                </Grid>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding HeadlessOptions}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource PermissionCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="8"
                                                                Background="{StaticResource AccentSoftBrush}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding HeadlessDescription}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="3" Style="{StaticResource AccentToggle}"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ TAB 3: CÀI ĐẶT ============ -->
                    <Grid x:Name="SettingsTab" Visibility="Collapsed">
                        <Border Style="{StaticResource InnerPanel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="Cài đặt ứng dụng" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Chưa có cấu hình cấp ứng dụng nào. Tab này sẽ hiển thị các tuỳ chọn như đường dẫn Chrome, thư mục lưu file hay thời gian chờ khi cần."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <Button Content="Đổi mật khẩu admin" Style="{StaticResource SecondaryButton}"
                                        Height="36" Margin="0,16,0,0" HorizontalAlignment="Left"
                                        Click="ChangeAdminPassword_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===================== FOOTER ===================== -->
            <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource RestoreButton}" Command="{Binding RestoreDefaultsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Khôi phục mặc định" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Lưu thay đổi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Hủy" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>